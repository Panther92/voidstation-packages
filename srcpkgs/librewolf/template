# Template file for 'librewolf'
#
# Official AppImage from librewolf.dev (bsys6 releases), unpacked (no FUSE,
# no AppImage runtime at run time) and installed to /usr/lib/librewolf.
# Upstream version 147.0.1-1 becomes 147.0.1.1 (xbps versions have no '-');
# _dl is the download address from the release API.
# Version and checksum are maintained by ci/update.py (update.json).
pkgname=librewolf
version=160.0.1
revision=1
archs="x86_64"
_file="librewolf-${version}.AppImage"
_dl="https://dl.librewolf.net/librewolf/160.0-1/librewolf-160.0-1-linux-x86_64-appimage.AppImage"
depends="gtk+3 dbus-glib libXt alsa-lib ffmpeg6 xdg-utils"
short_desc="LibreWolf web browser - official release, repackaged"
maintainer="Paul Volz <paulvolz92@gmail.com>"
license="MPL-2.0"
homepage="https://librewolf.net"
distfiles="${_dl}>${_file}"
checksum=656054abcc32f39b6d720cc76ea4359dbceff465ca039b2d963050ce0d1f9005
skip_extraction="${_file}"
nostrip=yes
nopie=yes
noshlibprovides=yes
noverifyrdeps=yes

do_extract() {
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_file}" app.AppImage
	chmod +x app.AppImage
	./app.AppImage --appimage-extract >/dev/null
	rm app.AppImage
}

do_install() {
	vmkdir usr/lib/${pkgname}
	cp -a squashfs-root/. "${DESTDIR}/usr/lib/${pkgname}/"
	chmod 755 "${DESTDIR}/usr/lib/${pkgname}"
	# AppRun sets up the environment the app expects, APPDIR points it here
	vmkdir usr/bin
	cat > "${DESTDIR}/usr/bin/${pkgname}" <<-EOF
	#!/bin/sh
	export APPDIR=/usr/lib/${pkgname}
	exec /usr/lib/${pkgname}/AppRun "\$@"
	EOF
	chmod 755 "${DESTDIR}/usr/bin/${pkgname}"
	# desktop file and icon, if the AppImage has them at the top
	local d
	for d in squashfs-root/*.desktop; do
		[ -f "$d" ] || continue
		sed -e "s|^Exec=[^ ]*|Exec=/usr/bin/${pkgname}|" "$d" > "${pkgname}.desktop"
		vinstall "${pkgname}.desktop" 644 usr/share/applications
	done
	for d in squashfs-root/*.png; do
		[ -f "$d" ] && vinstall "$d" 644 usr/share/pixmaps "${pkgname}.png"
	done
	return 0
}
