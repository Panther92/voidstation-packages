# Template file for 'mission-center'
#
# Official AppImage from the GitLab releases of mission-center-devs, unpacked
# (no FUSE, no AppImage runtime at run time) and installed to
# /usr/lib/mission-center. A build from source would follow the system GTK
# theme, but upstream builds with its own clang/Rust toolchains (see the
# Flathub manifest) - repackaging first, source build later if worth it.
# _dl is the download address from the release API.
# Version and checksum are maintained by ci/update.py (update.json).
pkgname=mission-center
version=1.2.0
revision=1
archs="x86_64"
_file="mission-center-${version}.AppImage"
_dl="https://gitlab.com/mission-center-devs/mission-center/-/jobs/15536631699/artifacts/raw/MissionCenter-1.2.0-x86_64.AppImage"
depends="dbus"
short_desc="Monitor CPU, memory, disk, network and GPU usage - official release, repackaged"
maintainer="Paul Volz <paulvolz92@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://missioncenter.io"
distfiles="${_dl}>${_file}"
checksum=b3b5c84470a927d189c251039d223464125f7068b3164fda43acb9100384576d
skip_extraction="${_file}"
nostrip=yes
nopie=yes
noshlibprovides=yes
noverifyrdeps=yes

do_extract() {
	cp "${XBPS_SRCDISTDIR}/${pkgname}-${version}/${_file}" app.AppImage
	chmod +x app.AppImage
	./app.AppImage --appimage-extract >/dev/null
	rm app.AppImage
	# some AppImages ship world-writable files (xbps-src refuses them)
	chmod -R go-w squashfs-root
}

do_install() {
	vmkdir usr/lib/${pkgname}
	cp -a squashfs-root/. "${DESTDIR}/usr/lib/${pkgname}/"
	chmod 755 "${DESTDIR}/usr/lib/${pkgname}"
	# AppRun sets up the environment the app expects, APPDIR points it here
	vmkdir usr/bin
	cat > "${DESTDIR}/usr/bin/${pkgname}" <<-EOF
	#!/bin/sh
	export APPDIR=/usr/lib/${pkgname}
	exec /usr/lib/${pkgname}/AppRun "\$@"
	EOF
	chmod 755 "${DESTDIR}/usr/bin/${pkgname}"
	# desktop file and icon, if the AppImage has them at the top
	local d
	for d in squashfs-root/*.desktop; do
		[ -f "$d" ] || continue
		sed -e "s|^Exec=[^ ]*|Exec=/usr/bin/${pkgname}|" "$d" > "${pkgname}.desktop"
		vinstall "${pkgname}.desktop" 644 usr/share/applications
	done
	for d in squashfs-root/*.png; do
		# not "[ ] && vinstall": vinstall is an alias starting with "set -f;",
		# so the && would only guard that part
		if [ -f "$d" ]; then
			vinstall "$d" 644 usr/share/pixmaps "${pkgname}.png"
		fi
	done
	return 0
}
