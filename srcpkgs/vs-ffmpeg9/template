# Template file for 'vs-ffmpeg9'
#
# FFmpeg 9 libraries for programs that load them themselves at run time,
# today only PCSX2 (video capture: it dlopen()s libavcodec.so.<major> of the
# headers it was built with). Void ships ffmpeg 4.4 and ffmpeg6; mpv and
# everything else keep using those - different sonames (.so.63 here,
# .so.60 for ffmpeg6), so nothing else changes.
#
# Default build is slim on purpose: encoders and muxers for recording only,
# no decoders/demuxers/network protocols for foreign media (smaller attack
# surface; this package does not parse untrusted files). build option
# "full" gives a complete FFmpeg for a possible later vs-mpv.
#
# Runtime libraries go to /usr/lib (needed for dlopen); headers, pkg-config
# files and the unversioned .so links live in their own directories so the
# -devel package does not clash with ffmpeg6-devel.
pkgname=vs-ffmpeg9
version=0
revision=1
hostmakedepends="pkg-config nasm"
makedepends="x264-devel opus-devel libva-devel libdrm-devel"
short_desc="FFmpeg 9 libraries for VoidStation (PCSX2 video capture)"
maintainer="Paul Volz <paulvolz92@gmail.com>"
license="GPL-2.0-or-later"
homepage="https://ffmpeg.org"
distfiles="https://ffmpeg.org/releases/ffmpeg-${version}.tar.xz"
checksum=PENDING
build_options="full"
desc_option_full="Complete FFmpeg instead of the slim recording-only build"

_prefix=/usr/lib/vs-ffmpeg9

do_configure() {
	local opts="--prefix=/usr --incdir=/usr/include/vs-ffmpeg9
	 --enable-shared --disable-static --enable-pic
	 --disable-programs --disable-doc --disable-debug
	 --disable-avdevice --disable-avfilter
	 --enable-gpl --enable-libx264 --enable-libopus --enable-vaapi"
	if [ -z "$build_option_full" ]; then
		opts+=" --disable-everything
		 --enable-encoder=libx264,h264_vaapi,hevc_vaapi,av1_vaapi,aac,libopus,flac,pcm_s16le
		 --enable-muxer=mp4,mov,matroska,webm
		 --enable-protocol=file
		 --enable-parser=h264,hevc,av1,aac,opus
		 --enable-bsf=aac_adtstoasc,h264_mp4toannexb,hevc_mp4toannexb,extract_extradata"
	fi
	# shellcheck disable=SC2086
	./configure ${opts} --cc="$CC" --cxx="$CXX" \
		--extra-cflags="$CFLAGS" --extra-ldflags="$LDFLAGS"
}

do_build() {
	make ${makejobs}
}

do_install() {
	make DESTDIR="${DESTDIR}" install
	# keep only the versioned runtime libraries in /usr/lib
	vmkdir ${_prefix}
	mv "${DESTDIR}/usr/lib/pkgconfig" "${DESTDIR}${_prefix}/pkgconfig"
	local l real
	for l in "${DESTDIR}"/usr/lib/lib*.so; do
		real="$(readlink "$l")"
		rm "$l"
		ln -s "../${real}" "${DESTDIR}${_prefix}/${l##*/}"
	done
	sed -i "s|^libdir=.*|libdir=${_prefix}|" "${DESTDIR}${_prefix}"/pkgconfig/*.pc
}

vs-ffmpeg9-devel_package() {
	depends="${sourcepkg}>=${version}_${revision}"
	short_desc+=" - development files"
	pkg_install() {
		vmove usr/include/vs-ffmpeg9
		vmove ${_prefix}
	}
}
