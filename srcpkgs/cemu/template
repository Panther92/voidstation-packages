# Template file for 'cemu'
#
# Wii U emulator, built from the release tag against Void's libraries
# (ENABLE_VCPKG=OFF): the release still uses wxWidgets 3.2 and SDL2 (only
# master needs wxWidgets 3.3). Bundled submodules only for what Void lacks:
# ZArchive, cubeb, Vulkan-Headers, imgui (fetched with git, commit pinned in
# _commit; vcpkg is left out). GTK 3 from Void, so the UI follows the theme.
# Version and commit are maintained by ci/update.py (update.json).
pkgname=cemu
version=2.6
revision=1
_commit="a6fb0a48eb437a8a41c13b782ac8ae0433bf8f98"
archs="x86_64"
build_style=cmake
configure_args="-DENABLE_VCPKG=OFF -DALLOW_PORTABLE=OFF -DENABLE_DISCORD_RPC=OFF
 -DwxWidgets_CONFIG_EXECUTABLE=/usr/bin/wx-config-gtk3
 -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++"
hostmakedepends="git pkg-config clang nasm wayland-devel"
makedepends="SDL2-devel libcurl-devel pugixml-devel rapidjson boost-devel
 libzip-devel glslang-devel SPIRV-Tools-devel zlib-devel libzstd-devel
 openssl-devel glm fmt-devel libpng-devel libX11-devel wayland-devel
 wayland-protocols gtk+3-devel libbluetooth-devel MesaLib-devel hidapi-devel
 wxWidgets-gtk3-devel libusb-devel pulseaudio-devel alsa-lib-devel"
short_desc="Nintendo Wii U emulator"
maintainer="Paul Volz <paulvolz92@gmail.com>"
license="MPL-2.0"
homepage="https://cemu.info"

do_fetch() {
	rm -rf "${wrksrc}"
	git clone --quiet --depth 1 --branch "v${version}" \
		https://github.com/cemu-project/Cemu.git "${wrksrc}"
	if [ "$(git -C "${wrksrc}" rev-parse HEAD)" != "${_commit}" ]; then
		msg_error "tag v${version} is $(git -C "${wrksrc}" rev-parse HEAD), expected ${_commit}\n"
	fi
	git -C "${wrksrc}" submodule --quiet update --init --depth 1 \
		dependencies/ZArchive dependencies/cubeb \
		dependencies/Vulkan-Headers dependencies/imgui
	# cubeb has submodules of its own (googletest, sanitizers): not needed
}

do_extract() {
	:
}

do_install() {
	# no install target on Linux: take what the build put into bin/
	# (executable Cemu_<build type>, plus gameProfiles/ and resources/)
	local exe
	vmkdir usr/lib/cemu
	cp -a bin/. "${DESTDIR}/usr/lib/cemu/"
	for exe in "${DESTDIR}"/usr/lib/cemu/Cemu_*; do
		if [ -f "$exe" ] && [ -x "$exe" ]; then
			vmkdir usr/bin
			ln -s "/usr/lib/cemu/${exe##*/}" "${DESTDIR}/usr/bin/cemu"
		fi
	done
	if [ ! -L "${DESTDIR}/usr/bin/cemu" ]; then
		msg_error "no Cemu executable in bin/\n"
	fi
	sed -e 's|^Exec=.*|Exec=cemu|' dist/linux/info.cemu.Cemu.desktop > cemu.desktop
	vinstall cemu.desktop 644 usr/share/applications info.cemu.Cemu.desktop
	vinstall dist/linux/info.cemu.Cemu.png 644 usr/share/pixmaps
	vlicense LICENSE.txt
}
