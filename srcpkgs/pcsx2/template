# Template file for 'pcsx2'
#
# PlayStation 2 emulator, built from the release tag with clang (upstream's
# only supported compiler). FFmpeg comes from vs-ffmpeg9: PCSX2 needs >= 7.1
# (upstream itself ships 9.0), Void has 6. It is loaded at runtime (dlopen)
# for video capture only, so the headers are taken from vs-ffmpeg9-devel and
# vs-ffmpeg9 is a plain runtime dependency. plutovg, plutosvg and rapidyaml
# are static build dependencies from this repository.
# Version and checksum are maintained by ci/update.py (update.json).
pkgname=pcsx2
version=0
revision=1
archs="x86_64"
build_style=cmake
configure_args="-DPACKAGE_MODE=ON -DENABLE_TESTS=OFF -DDISABLE_ADVANCE_SIMD=TRUE
 -DUSE_LINKED_FFMPEG=OFF -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++
 -DCMAKE_INCLUDE_PATH=/usr/include/vs-ffmpeg9
 -DCMAKE_LIBRARY_PATH=/usr/lib/vs-ffmpeg9"
hostmakedepends="clang pkg-config extra-cmake-modules qt6-base qt6-tools
 wayland-devel"
makedepends="qt6-base-devel qt6-base-private-devel qt6-tools-devel
 kddockwidgets-devel SDL3-devel libpng-devel libjpeg-turbo-devel zlib-devel
 libzstd-devel liblz4-devel libwebp-devel freetype-devel fontconfig-devel
 libcurl-devel libpcap-devel libX11-devel libXrandr-devel wayland-devel
 libbacktrace shaderc dbus-devel libpulseaudio-devel alsa-lib-devel
 plutovg plutosvg rapidyaml vs-ffmpeg9-devel"
depends="vs-ffmpeg9"
short_desc="PlayStation 2 emulator"
maintainer="Paul Volz <paulvolz92@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://pcsx2.net"
distfiles="https://github.com/PCSX2/pcsx2/archive/refs/tags/v${version}.tar.gz"
checksum=PENDING

post_install() {
	vinstall .github/workflows/scripts/linux/pcsx2-qt.desktop 644 \
		usr/share/applications net.pcsx2.PCSX2.desktop
	vinstall bin/resources/icons/AppIconLarge.png 644 \
		usr/share/icons/hicolor/512x512/apps PCSX2.png
}
