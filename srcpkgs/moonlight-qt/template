# Template file for 'moonlight-qt'
#
# Built from the release source tarball (includes the git submodules) against
# Void's Qt 6, SDL2 and ffmpeg6 - follows the system Qt theme, unlike the
# AppImage with its bundled Qt. Also for i686 (old laptops as streaming
# clients).
# Version and checksum are maintained by ci/update.py (update.json).
pkgname=moonlight-qt
version=0
revision=1
hostmakedepends="pkg-config qt6-base qt6-declarative qt6-tools"
makedepends="qt6-base-devel qt6-declarative-devel qt6-svg-devel SDL2-devel
 SDL2_ttf-devel ffmpeg6-devel opus-devel libva-devel libvdpau-devel
 openssl-devel libdrm-devel wayland-devel libplacebo-devel"
depends="qt6-svg qt6-declarative"
short_desc="Game streaming client for Sunshine and NVIDIA GameStream"
maintainer="Paul Volz <paulvolz92@gmail.com>"
license="GPL-3.0-or-later"
homepage="https://moonlight-stream.org"
distfiles="https://github.com/moonlight-stream/moonlight-qt/releases/download/v${version}/MoonlightSrc-${version}.tar.gz"
checksum=PENDING
create_wrksrc=yes

do_configure() {
	qmake6 PREFIX=/usr CONFIG+=disable-prebuilts moonlight-qt.pro
}

do_build() {
	make ${makejobs}
}

do_install() {
	make INSTALL_ROOT="${DESTDIR}" install
}
